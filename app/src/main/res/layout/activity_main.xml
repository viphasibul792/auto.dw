<?xml version="1.0" encoding="utf-8"?>
<!--
    Recreates the HTML <body> + .container structure:
    light grey page background (#f4f6f9) with a white, rounded, shadowed card
    (max-width 650dp, centered) that holds the title, the nav tabs and content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="@dimen/page_padding">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_container"
        android:elevation="@dimen/container_elevation"
        android:maxWidth="@dimen/container_max_width"
        android:orientation="vertical"
        android:padding="@dimen/container_padding"
        tools:ignore="UselessParent">

        <!-- h2: Google Drive Tool Suite -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title"
            android:textColor="@color/google_blue"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Navigation tabs (.nav-tabs + .tab-btn.active) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:layout_marginBottom="@dimen/space_xlarge"
            android:background="@drawable/bg_tab_layout"
            app:tabIndicatorColor="@color/google_blue"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="@dimen/tab_indicator_height"
            app:tabMode="fixed"
            app:tabRippleColor="@color/tab_ripple"
            app:tabSelectedTextColor="@color/google_blue"
            app:tabTextAppearance="@style/TextAppearance.DriveToolSuite.Tab"
            app:tabTextColor="@color/tab_text_color" />

        <!-- Tab content panels (.tab-content) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>
