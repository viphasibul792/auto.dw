<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 2: Bulk Downloader - mirrors the HTML #downloaderTab panel exactly. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_large">

        <!-- <p> intro text ("Start Downloads" is bolded in code) -->
        <TextView
            android:id="@+id/downloaderDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/downloader_description"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- textarea#linksInput -->
        <EditText
            android:id="@+id/linksInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/bg_input_selector"
            android:gravity="top|start"
            android:hint="@string/downloader_input_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minHeight="@dimen/input_height"
            android:padding="@dimen/space_large"
            android:textColor="@color/text_input"
            android:textColorHint="@color/hint"
            android:textSize="@dimen/text_body" />

        <!-- .btn-container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- button#downloadBtn.action-btn: Start Downloads -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/button_min_width"
                android:paddingStart="@dimen/space_xlarge"
                android:paddingEnd="@dimen/space_xlarge"
                android:text="@string/action_start_downloads"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button"
                app:backgroundTint="@color/color_action_button"
                app:cornerRadius="@dimen/button_corner_radius" />
        </LinearLayout>

        <!-- div#status -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_status"
            android:textStyle="bold" />

        <!-- .note tip box (left 4dp blue border, light blue fill) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:padding="@dimen/space_medium">

            <TextView
                android:id="@+id/noteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/note"
                android:textColor="@color/note_text"
                android:textSize="@dimen/text_note" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
